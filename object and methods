class dream
{
    int cse, ese, it;

    public void set_dimension(int a, int b, int c)
    {
        cse = a;
        ese = b;
        it = c;
    }

    public void display()
    {
        int t = cse + ese + it;
        System.out.println("Total " + t);
    }
}

public class Main
{
    public static void main(String[] args)
    {
        dream x = new dream();
        x.set_dimension(80, 30, 40);
        x.display();
    }
}
